# Copy to `supabase.env` and fill in. `supabase.env` is gitignored.
#
#   cp app/supabase.env.example app/supabase.env
#
# Both values below are PUBLIC by design — the anon key is meant to ship inside
# client bundles, and row-level security is what actually protects the data.
# Find them in: Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...

# DO NOT put the service_role key here. It bypasses RLS entirely. Nothing in
# app/ needs it: the Flutter app writes as the signed-in user, and the sensor
# bridge never touches the database.
