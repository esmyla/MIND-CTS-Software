#define TEMP_PIN A2        // TMP36 output connected to A0
#define HEATER_PIN 5       // MOSFET gate (optional, if testing heater)

void setup() {
  Serial.begin(115200);
  pinMode(HEATER_PIN, OUTPUT);
  digitalWrite(HEATER_PIN, HIGH);  // heater OFF at start
}

void loop() {
  // Read TMP36
  int raw = analogRead(TEMP_PIN);
  float voltage = raw * (5.0 / 1023.0);

  // TMP36 conversion
  float tempC = (voltage - 0.5) * 100.0;
  float tempF = tempC * 9.0 / 5.0 + 32.0;

  // Print to Serial Monitor
  Serial.print("Raw: ");
  Serial.print(raw);
  Serial.print(" | Voltage: ");
  Serial.print(voltage, 3);
  Serial.print(" V | Temp: ");
  Serial.print(tempC, 2);
  Serial.print(" °C  /  ");
  Serial.print(tempF, 2);
  Serial.println(" °F");

  delay(1000);  // update every 1 second
}

